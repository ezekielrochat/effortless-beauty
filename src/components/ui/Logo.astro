---
import { media } from '@/config/media';
import { siteConfig } from '@/config/site';

interface Props {
  variant?: 'color' | 'white';
  class?: string;
}

const { variant = 'color', class: className = '' } = Astro.props;
const src = variant === 'white' ? media.logo.white : media.logo.color;
---

<a href="/" class:list={['inline-flex shrink-0 items-center', className]} aria-label={siteConfig.name}>
  <img src={src} alt={media.logo.alt} class="h-10 w-auto sm:h-11" />
</a>
