---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  fetchpriority,
  sizes,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  sizes={sizes}
  decoding="async"
/>
