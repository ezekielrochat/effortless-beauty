---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
  align?: 'left' | 'center';
  width?: 'narrow' | 'wide';
}

const {
  eyebrow,
  title,
  description,
  class: className = '',
  align = 'center',
  width = 'wide',
} = Astro.props;

const isCenter = align === 'center';
---

<section class:list={['py-16 sm:py-20 lg:py-24', className]}>
  <div class="container-site">
    <div
      class:list={[
        width === 'wide' ? 'max-w-5xl' : 'max-w-3xl',
        'mx-auto',
        isCenter ? 'text-center' : undefined,
      ]}
    >
      {
        eyebrow && (
          <p class="font-heading text-[0.68rem] font-semibold tracking-[0.24em] text-[var(--color-brand-500)] uppercase">
            {eyebrow}
          </p>
        )
      }
      <h2
        class:list={[
          'text-3xl leading-tight tracking-[-0.01em] sm:text-4xl lg:text-[2.75rem]',
          eyebrow ? 'mt-4' : undefined,
        ]}
      >
        {title}
      </h2>
      {
        description && (
          <p
            class:list={[
              'mt-5 text-base leading-relaxed text-muted sm:text-lg',
              isCenter ? 'mx-auto max-w-2xl' : 'max-w-2xl',
            ]}
          >
            {description}
          </p>
        )
      }
      <div class="mt-12">
        <slot />
      </div>
    </div>
  </div>
</section>
