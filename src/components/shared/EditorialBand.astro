---
import SiteImage from '@/components/ui/SiteImage.astro';

interface Image {
  src: string;
  alt: string;
}

interface Props {
  image: Image;
  caption?: string;
  class?: string;
}

const { image, caption, class: className = '' } = Astro.props;
---

<section class:list={['py-3 sm:py-4', className]}>
  <div class="frame-bleed">
    <figure class="frame-media mx-auto w-fit max-w-full">
      <SiteImage src={image.src} alt={image.alt} class="frame-photo" />
      {
        caption && (
          <figcaption class="sr-only">{caption}</figcaption>
        )
      }
    </figure>
  </div>
</section>
