---
interface Item {
  title: string;
  description: string;
}

interface Props {
  items: readonly Item[];
  columns?: 1 | 2 | 3;
  numbered?: boolean;
}

const { items, columns = 1, numbered = true } = Astro.props;

const gridClass =
  columns === 3
    ? 'grid gap-8 sm:gap-10 lg:grid-cols-3'
    : columns === 2
      ? 'grid gap-8 sm:gap-10 sm:grid-cols-2'
      : 'mx-auto grid max-w-2xl gap-10';
---

<ul class={gridClass}>
  {
    items.map((item, index) => (
      <li class:list={[columns === 1 ? 'text-left' : 'text-center sm:text-left']}>
        {numbered && (
          <p class="font-heading text-[0.68rem] font-semibold tracking-[0.22em] text-accent uppercase">
            {String(index + 1).padStart(2, '0')}
          </p>
        )}
        <h3 class:list={['text-xl leading-snug sm:text-2xl', numbered ? 'mt-3' : undefined]}>
          {item.title}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{item.description}</p>
      </li>
    ))
  }
</ul>
