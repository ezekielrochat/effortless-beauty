---
interface Item {
  title: string;
  description: string;
}

interface Props {
  items: readonly Item[];
  columns?: 1 | 2 | 3;
  numbered?: boolean;
}

const { items, columns = 1, numbered = true } = Astro.props;

const isVertical = columns === 1;

const gridClass = isVertical
  ? 'mx-auto max-w-xl divide-y divide-[var(--color-border)] border-y border-default text-left'
  : columns === 3
    ? 'grid gap-8 sm:gap-10 lg:grid-cols-3'
    : 'grid gap-8 sm:gap-10 sm:grid-cols-2';
---

<ul class={gridClass}>
  {
    items.map((item, index) => (
      <li
        class:list={[
          isVertical
            ? 'flex gap-5 py-6 sm:gap-6 sm:py-7'
            : 'text-center sm:text-left',
        ]}
      >
        {numbered && (
          <p
            class:list={[
              'font-heading text-[0.68rem] font-semibold tracking-[0.22em] text-accent uppercase',
              isVertical ? 'shrink-0 pt-1' : undefined,
            ]}
          >
            {String(index + 1).padStart(2, '0')}
          </p>
        )}
        <div>
          <h3
            class:list={[
              'text-xl leading-snug sm:text-2xl',
              numbered && !isVertical ? 'mt-3' : undefined,
            ]}
          >
            {item.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted sm:mt-3 sm:text-base">
            {item.description}
          </p>
        </div>
      </li>
    ))
  }
</ul>
