---
import SiteImage from '@/components/ui/SiteImage.astro';

interface PathItem {
  title: string;
  description: string;
  href: string;
  cta: string;
  image: {
    src: string;
    alt: string;
  };
}

interface Props {
  items: readonly PathItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-2 sm:gap-2.5 md:grid-cols-2">
  {
    items.map((item) => (
      <a
        href={item.href}
        class="group relative block overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-gold-500)] lg:rounded-[0.625rem]"
      >
        <SiteImage
          src={item.image.src}
          alt={item.image.alt}
          class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/10"
          aria-hidden="true"
        />
        <div class="absolute inset-x-0 bottom-0 p-7 sm:p-8">
          <h3 class="text-2xl text-white sm:text-3xl">{item.title}</h3>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/85 sm:text-base">
            {item.description}
          </p>
          <span class="btn btn-outline-light mt-6 px-5 py-2 text-xs uppercase">
            {item.cta}
          </span>
        </div>
      </a>
    ))
  }
</div>
