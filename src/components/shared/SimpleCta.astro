---
import Button from '@/components/ui/Button.astro';

interface Props {
  title?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Book your date now',
  primaryLabel = 'Check your date',
  primaryHref = '/contact',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="cta-band">
  <div class="container-site flex min-h-[22rem] flex-col items-center justify-center py-24 text-center sm:min-h-[26rem] sm:py-28 lg:min-h-[28rem] lg:py-32">
    <h2 class="max-w-2xl text-3xl text-white sm:text-4xl">{title}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={primaryHref} variant="light" class="uppercase">
        {primaryLabel}
      </Button>
      {
        secondaryLabel && secondaryHref && (
          <Button href={secondaryHref} variant="outline-light" class="uppercase">
            {secondaryLabel}
          </Button>
        )
      }
    </div>
  </div>
</section>
