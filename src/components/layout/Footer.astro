---
import { brandNav, footerColumns, footerNav, footerLegal, ctaNav } from '@/config/navigation';
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site';
import { MapPin, Phone, Mail } from '@lucide/astro';

const year = new Date().getFullYear();
const linkClass =
  'text-sm text-muted transition-colors hover:text-[var(--color-brand-900)]';
const headingClass =
  'font-heading text-[0.68rem] tracking-[0.16em] uppercase text-[var(--color-brand-900)]';
---

<footer class="bg-[var(--color-surface-elevated)]">
  <div class="container-site py-14 sm:py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-10 xl:gap-14">
      {/* Brand */}
      <div class="max-w-sm">
        <Logo />
        <p class="mt-5 text-sm leading-relaxed text-muted">
          {siteConfig.tagline} Luxury bridal hair and makeup for Knoxville, East TN, and the
          Smoky Mountains.
        </p>
        <div class="mt-7">
          <Button href={ctaNav.href} variant="dark" size="sm" class="uppercase">
            {ctaNav.label}
          </Button>
        </div>
      </div>

      {/* Link columns */}
      {
        footerColumns.map((column) => (
          <nav aria-label={column.title}>
            <p class={headingClass}>{column.title}</p>
            <ul class="mt-5 space-y-3">
              {column.links.map((item) => (
                <li>
                  <a href={item.href} class={linkClass}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      {/* Contact */}
      <div>
        <p class={headingClass}>Visit & contact</p>
        <address class="mt-5 not-italic">
          <ul class="space-y-4 text-sm text-muted">
            <li class="flex gap-3">
              <MapPin
                size={16}
                strokeWidth={1.75}
                class="mt-0.5 shrink-0 text-[var(--color-brand-500)]"
                aria-hidden="true"
              />
              <span class="leading-relaxed">
                {siteConfig.contact.address.street}
                <br />
                {siteConfig.contact.address.city}, {siteConfig.contact.address.state}{' '}
                {siteConfig.contact.address.zip}
              </span>
            </li>
            <li>
              <a href={siteConfig.contact.phoneHref} class:list={['flex gap-3', linkClass]}>
                <Phone
                  size={16}
                  strokeWidth={1.75}
                  class="mt-0.5 shrink-0 text-[var(--color-brand-500)]"
                  aria-hidden="true"
                />
                {siteConfig.contact.phone}
              </a>
            </li>
            <li>
              <a href={siteConfig.contact.emailHref} class:list={['flex gap-3', linkClass]}>
                <Mail
                  size={16}
                  strokeWidth={1.75}
                  class="mt-0.5 shrink-0 text-[var(--color-brand-500)]"
                  aria-hidden="true"
                />
                <span class="break-all">{siteConfig.contact.email}</span>
              </a>
            </li>
          </ul>
        </address>

        <div class="mt-8">
          <p class={headingClass}>Follow</p>
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['mt-4 inline-flex items-center gap-2', linkClass]}
          >
            <span
              class="flex size-8 items-center justify-center rounded-full border border-default"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="size-3.5 fill-current" aria-hidden="true">
                <path
                  d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 1 0 12 7.2zm0 7.92A3.12 3.12 0 1 1 12 8.88a3.12 3.12 0 0 1 0 6.24zM17.52 6.9a1.12 1.12 0 1 1-2.24 0 1.12 1.12 0 0 1 2.24 0z"
                ></path>
                <path
                  d="M12 2.4c-2.6 0-2.93.01-3.96.06-1.02.05-1.72.21-2.33.45a4.7 4.7 0 0 0-1.7 1.1 4.7 4.7 0 0 0-1.1 1.7c-.24.61-.4 1.31-.45 2.33C2.41 9.07 2.4 9.4 2.4 12s.01 2.93.06 3.96c.05 1.02.21 1.72.45 2.33a4.7 4.7 0 0 0 1.1 1.7 4.7 4.7 0 0 0 1.7 1.1c.61.24 1.31.4 2.33.45 1.03.05 1.36.06 3.96.06s2.93-.01 3.96-.06c1.02-.05 1.72-.21 2.33-.45a4.7 4.7 0 0 0 1.7-1.1 4.7 4.7 0 0 0 1.1-1.7c.24-.61.4-1.31.45-2.33.05-1.03.06-1.36.06-3.96s-.01-2.93-.06-3.96c-.05-1.02-.21-1.72-.45-2.33a4.7 4.7 0 0 0-1.1-1.7 4.7 4.7 0 0 0-1.7-1.1c-.61-.24-1.31-.4-2.33-.45C14.93 2.41 14.6 2.4 12 2.4zm0 1.68c2.56 0 2.86.01 3.86.06.93.04 1.44.2 1.78.33.45.17.77.38 1.1.72.34.33.55.65.72 1.1.13.34.29.85.33 1.78.05 1 .06 1.3.06 3.86s-.01 2.86-.06 3.86c-.04.93-.2 1.44-.33 1.78-.17.45-.38.77-.72 1.1-.33.34-.65.55-1.1.72-.34.13-.85.29-1.78.33-1 .05-1.3.06-3.86.06s-2.86-.01-3.86-.06c-.93-.04-1.44-.2-1.78-.33a2.97 2.97 0 0 1-1.1-.72 2.97 2.97 0 0 1-.72-1.1c-.13-.34-.29-.85-.33-1.78-.05-1-.06-1.3-.06-3.86s.01-2.86.06-3.86c.04-.93.2-1.44.33-1.78.17-.45.38-.77.72-1.1.33-.34.65-.55 1.1-.72.34-.13.85-.29 1.78-.33 1-.05 1.3-.06 3.86-.06z"
                ></path>
              </svg>
            </span>
            {siteConfig.social.handle}
          </a>
        </div>
      </div>
    </div>

    {/* Sister brands */}
    <div class="mt-14 border-t border-default pt-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class={headingClass}>The Effortless Collective</p>
        <nav class="flex flex-wrap items-center gap-x-1 gap-y-2" aria-label="Sister brands">
          {
            brandNav.map((item, index) => (
              <span class="inline-flex items-center">
                {index > 0 && (
                  <span class="mx-2.5 text-[var(--color-brand-300)]" aria-hidden="true">
                    |
                  </span>
                )}
                <a
                  href={item.href}
                  class:list={[
                    'text-sm transition-colors hover:text-[var(--color-brand-900)]',
                    item.current ? 'text-[var(--color-brand-900)]' : 'text-muted',
                  ]}
                  aria-current={item.current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </span>
            ))
          }
        </nav>
      </div>
    </div>
  </div>

  <div class="bg-[var(--color-charcoal)] py-4 text-[0.7rem] tracking-wide text-[var(--color-text-on-dark-muted)]">
    <div class="container-site flex flex-col items-center justify-between gap-3 sm:flex-row">
      <p>
        © {year} {footerLegal.copyrightName}
      </p>
      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-1" aria-label="Legal">
        {
          footerNav.map((item) => (
            <a href={item.href} class="transition-colors hover:text-white">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
