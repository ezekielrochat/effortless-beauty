---
import { homeContent } from '@/config/home';
import { media } from '@/config/media';
import SiteImage from '@/components/ui/SiteImage.astro';

const { explore } = homeContent;
---

<section id="explore" class="pt-14 sm:pt-20">
  <div class="container-site">
    <h2 class="text-center text-3xl text-white sm:text-4xl">{explore.title}</h2>
  </div>

  <div class="frame-bleed mt-10">
    <div class="grid gap-2 sm:gap-2.5 md:grid-cols-3">
      {
        explore.cards.map((card, index) => (
          <a href={card.href} class="explore-card group">
            <SiteImage
              src={media.explore[index].src}
              alt={media.explore[index].alt}
              class="explore-card__image aspect-[3/4] w-full object-cover"
            />
            <div class="explore-card__overlay" aria-hidden="true" />
            <div class="explore-card__content">
              <span class="explore-card__rule" aria-hidden="true" />
              <p class="explore-card__label font-heading text-lg tracking-[0.08em] text-white uppercase">
                {card.label}
              </p>
              <span class="explore-card__hint" aria-hidden="true">
                Explore
                <svg
                  class="explore-card__arrow"
                  viewBox="0 0 16 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M3 8h10M9 4l4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .explore-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.5rem;
    isolation: isolate;
    transform: translateZ(0);
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 1024px) {
    .explore-card {
      border-radius: 0.625rem;
    }
  }

  .explore-card:hover,
  .explore-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 28px 50px -28px rgb(0 0 0 / 0.65);
  }

  .explore-card:focus-visible {
    outline: 2px solid var(--color-gold-500);
    outline-offset: 3px;
  }

  .explore-card__image {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .explore-card:hover .explore-card__image,
  .explore-card:focus-visible .explore-card__image {
    transform: scale(1.06);
  }

  .explore-card__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgb(0 0 0 / 0.72) 0%,
        rgb(0 0 0 / 0.28) 42%,
        rgb(0 0 0 / 0.12) 100%
      );
    transition: background 0.55s ease;
  }

  .explore-card:hover .explore-card__overlay,
  .explore-card:focus-visible .explore-card__overlay {
    background:
      linear-gradient(
        to top,
        rgb(0 0 0 / 0.82) 0%,
        rgb(0 0 0 / 0.38) 48%,
        rgb(0 0 0 / 0.18) 100%
      );
  }

  .explore-card__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.75rem 1.5rem 1.5rem;
    text-align: center;
  }

  .explore-card__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-bottom: 0.85rem;
    background: var(--color-gold-500);
    transform: scaleX(0.35);
    opacity: 0.55;
    transform-origin: center;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease;
  }

  .explore-card:hover .explore-card__rule,
  .explore-card:focus-visible .explore-card__rule {
    transform: scaleX(1);
    opacity: 1;
  }

  .explore-card__label {
    margin: 0;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .explore-card:hover .explore-card__label,
  .explore-card:focus-visible .explore-card__label {
    transform: translateY(-4px);
  }

  .explore-card__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.55rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.82);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .explore-card:hover .explore-card__hint,
  .explore-card:focus-visible .explore-card__hint {
    opacity: 1;
    transform: translateY(0);
  }

  .explore-card__arrow {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .explore-card:hover .explore-card__arrow,
  .explore-card:focus-visible .explore-card__arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-card,
    .explore-card__image,
    .explore-card__overlay,
    .explore-card__rule,
    .explore-card__label,
    .explore-card__hint,
    .explore-card__arrow {
      transition: none;
    }

    .explore-card:hover,
    .explore-card:focus-visible {
      transform: none;
      box-shadow: none;
    }

    .explore-card:hover .explore-card__image,
    .explore-card:focus-visible .explore-card__image {
      transform: none;
    }

    .explore-card__hint {
      opacity: 0.85;
      transform: none;
    }

    .explore-card__rule {
      transform: scaleX(1);
      opacity: 0.85;
    }
  }
</style>
