---
import { homeContent } from '@/config/home';
import { media } from '@/config/media';
import Button from '@/components/ui/Button.astro';
import SiteImage from '@/components/ui/SiteImage.astro';

const { howItWorks } = homeContent;
---

<section id="how-it-works" class="py-14 sm:py-20">
  <div class="container-site">
    <h2 class="text-center text-3xl sm:text-4xl">{howItWorks.title}</h2>
  </div>

  <div class="frame-bleed mt-10 sm:mt-12">
    <div class="grid gap-2 sm:gap-2.5 lg:grid-cols-3">
      {
        howItWorks.steps.map((step, index) => (
          <article>
            <figure class="frame-media">
              <SiteImage
                src={media.howItWorks[index].src}
                alt={media.howItWorks[index].alt}
                class="aspect-[3/4] w-full object-cover"
              />
            </figure>
            <div class="px-1 pt-5 sm:pt-6">
              <p class="font-heading text-[0.65rem] tracking-[0.2em] text-[var(--color-brand-500)] uppercase">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-2 text-xl">{step.title}</h3>
              <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted sm:text-base">
                {step.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    <Button href={howItWorks.primaryCta.href} variant="dark" class="uppercase">
      {howItWorks.primaryCta.label}
    </Button>
    <Button href={howItWorks.secondaryCta.href} variant="outline" class="uppercase">
      {howItWorks.secondaryCta.label}
    </Button>
  </div>
</section>
