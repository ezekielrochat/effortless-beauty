---
import { homeContent } from '@/config/home';
import { media } from '@/config/media';
import Button from '@/components/ui/Button.astro';
import SiteImage from '@/components/ui/SiteImage.astro';

const { calmMorning } = homeContent;
---

<section id="experience" class="pt-6 pb-3 sm:pt-8 sm:pb-4">
  <div class="frame-bleed">
    <div class="frame-media bg-[var(--color-surface-elevated)]">
      <div class="grid lg:grid-cols-2 lg:min-h-[44rem]">
        <figure class="relative min-h-[24rem] lg:min-h-0">
          <SiteImage
            src={media.calmMorning.src}
            alt={media.calmMorning.alt}
            class="absolute inset-0 h-full w-full object-cover object-[center_20%]"
          />
        </figure>
        <div class="flex flex-col justify-center px-8 py-10 sm:px-12 sm:py-14 lg:px-14 lg:py-16">
          <h2 class="text-3xl leading-tight sm:text-4xl lg:text-[2.5rem]">
            {calmMorning.titleBefore}
            <span class="text-accent"> {calmMorning.titleAccent}</span>
          </h2>
          <p class="mt-5 max-w-md text-base leading-relaxed text-accent sm:text-lg">
            {calmMorning.description}
          </p>
          <div class="mt-8">
            <Button href="/experience" variant="outline" class="uppercase">
              Explore the experience
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
