---
import { homeContent } from '@/config/home';
import { Star } from '@lucide/astro';

const { testimonials } = homeContent;
const rowOne = testimonials.items;
const rowTwo = [...testimonials.items].reverse();

function initials(name: string) {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
}
---

<section id="testimonials" class="relative overflow-hidden pt-12 pb-16 sm:pt-16 sm:pb-24">
  <div class="relative">
    <div class="container-site">
      <h2 class="text-center text-3xl sm:text-4xl">{testimonials.title}</h2>
    </div>

    <div class="mt-10 space-y-5 sm:mt-12 sm:space-y-6" aria-label="Client reviews">
      <div class="marquee" data-direction="left">
        <div class="marquee__track">
          {[...rowOne, ...rowOne].map((item) => (
            <article class="marquee__card">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-beige)] text-xs font-medium text-muted"
                  aria-hidden="true"
                >
                  {initials(item.name)}
                </div>
                <p class="text-sm font-semibold text-[var(--color-brand-900)]">{item.name}</p>
              </div>
              <div class="mt-3 flex gap-0.5 text-[var(--color-accent-strong)]" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <Star size={13} fill="currentColor" stroke="currentColor" />
                ))}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.quote}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="marquee" data-direction="right">
        <div class="marquee__track">
          {[...rowTwo, ...rowTwo].map((item) => (
            <article class="marquee__card">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-beige)] text-xs font-medium text-muted"
                  aria-hidden="true"
                >
                  {initials(item.name)}
                </div>
                <p class="text-sm font-semibold text-[var(--color-brand-900)]">{item.name}</p>
              </div>
              <div class="mt-3 flex gap-0.5 text-[var(--color-accent-strong)]" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <Star size={13} fill="currentColor" stroke="currentColor" />
                ))}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.quote}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #testimonials .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  }

  #testimonials .marquee__track {
    display: flex;
    width: max-content;
    gap: 1.25rem;
    animation: testimonials-marquee-left 55s linear infinite;
    animation-play-state: running !important;
  }

  #testimonials .marquee[data-direction='right'] .marquee__track {
    animation-name: testimonials-marquee-right;
    animation-duration: 60s;
  }

  #testimonials .marquee:hover .marquee__track,
  #testimonials .marquee:focus-within .marquee__track {
    animation-play-state: running !important;
  }

  #testimonials .marquee__card {
    width: min(20rem, 78vw);
    flex-shrink: 0;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
    padding: 1.25rem 1.35rem;
    box-shadow: 0 10px 30px -18px rgb(35 31 32 / 0.28);
  }

  @keyframes testimonials-marquee-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes testimonials-marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #testimonials .marquee__track {
      animation: none !important;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 82rem;
      margin-inline: auto;
      padding-inline: 1.25rem;
    }

    #testimonials .marquee {
      mask-image: none;
    }
  }
</style>
