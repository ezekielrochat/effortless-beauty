---
import { homeContent } from '@/config/home';
import { media } from '@/config/media';
import Button from '@/components/ui/Button.astro';
import SiteImage from '@/components/ui/SiteImage.astro';

const { gallery } = homeContent;
---

<section id="gallery" class="py-10 sm:py-14 lg:py-16">
  <div class="frame-bleed">
    <figure class="frame-media">
      <SiteImage
        src={media.gallery.hero.src}
        alt={media.gallery.hero.alt}
        class="aspect-[16/9] w-full object-cover sm:aspect-[21/9] lg:aspect-[2.6/1]"
      />
    </figure>

    <div class="mt-2 grid grid-cols-2 gap-2 sm:mt-2.5 sm:grid-cols-3 sm:gap-2.5 lg:grid-cols-5">
      {
        media.gallery.grid.map((image) => (
          <figure class="frame-media">
            <SiteImage src={image.src} alt={image.alt} class="aspect-[3/4] w-full object-cover" />
          </figure>
        ))
      }
    </div>
  </div>

  <div class="mt-8 flex justify-center sm:mt-10">
    <Button href={gallery.cta.href} variant="dark" class="uppercase">
      {gallery.cta.label}
    </Button>
  </div>
</section>
