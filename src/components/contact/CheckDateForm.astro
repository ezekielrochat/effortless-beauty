---
import { siteConfig } from '@/config/site';
import { contactContent } from '@/config/pages/contact';

const { form } = contactContent;
const inputClass =
  'form-input w-full rounded-xl border border-default bg-[var(--color-surface-elevated)] px-4 py-3.5 text-base text-[var(--color-brand-900)] placeholder:text-subtle transition-[border-color,box-shadow] focus:border-[var(--color-brand-500)] focus:outline-none focus:ring-2 focus:ring-[color-mix(in_oklab,var(--color-brand-500)_25%,transparent)]';
const labelClass =
  'font-heading text-[0.68rem] font-semibold tracking-[0.16em] text-subtle uppercase';
const hintClass = 'mt-1.5 text-xs leading-relaxed text-subtle';
---

<section
  id="check-date-form"
  class="border-b border-default bg-[var(--color-surface-elevated)] py-16 sm:py-20 lg:py-24"
>
  <div class="container-site">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-heading text-[0.68rem] font-semibold tracking-[0.24em] text-[var(--color-brand-500)] uppercase">
        {form.eyebrow}
      </p>
      <h2 class="mt-4 text-3xl leading-tight tracking-[-0.01em] sm:text-4xl">{form.title}</h2>
      <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-muted sm:text-lg">
        {form.description}
      </p>
    </div>

    <div
      class="mx-auto mt-12 max-w-xl"
      data-check-date-form
      data-email={siteConfig.contact.email}
    >
      <nav class="mb-10 flex justify-center gap-2 sm:gap-3" data-form-progress aria-label="Form steps">
        {
          form.steps.map((step, index) => (
            <>
              <button
                type="button"
                class="group flex items-center gap-2 sm:gap-3"
                data-progress-item={index}
                aria-label={`Go to step ${index + 1}: ${step.title}`}
              >
                <span
                  class="flex size-9 items-center justify-center rounded-full border border-default bg-[var(--color-surface)] font-heading text-[0.68rem] font-semibold tracking-[0.12em] text-subtle transition-colors group-hover:border-[var(--color-brand-900)] sm:size-10"
                  data-progress-dot
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span
                  class="hidden font-heading text-[0.68rem] font-semibold tracking-[0.14em] text-subtle uppercase transition-colors group-hover:text-[var(--color-brand-900)] sm:inline"
                  data-progress-label
                >
                  {step.title}
                </span>
              </button>
              {index < form.steps.length - 1 && (
                <span class="mx-1 hidden h-px w-6 self-center bg-[var(--color-border)] sm:block" aria-hidden="true" />
              )}
            </>
          ))
        }
      </nav>

      <form class="text-left" novalidate>
        {/* Step 1 — About you */}
        <div data-form-panel="0">
          <p class="text-center text-sm text-muted sm:text-base">{form.steps[0].description}</p>

          <div class="mt-8 space-y-5">
            <div>
              <label class={labelClass} for="check-date-role">{form.fields.role.label}</label>
              <select
                class:list={[inputClass, 'mt-2']}
                id="check-date-role"
                name="role"
                required
              >
                <option value="" disabled selected>{form.fields.role.placeholder}</option>
                {
                  form.fields.role.options.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class={labelClass} for="check-date-name">{form.fields.name.label}</label>
              <input
                class:list={[inputClass, 'mt-2']}
                id="check-date-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder={form.fields.name.placeholder}
                required
              />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="check-date-phone">{form.fields.phone.label}</label>
                <input
                  class:list={[inputClass, 'mt-2']}
                  id="check-date-phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder={form.fields.phone.placeholder}
                  required
                />
              </div>
              <div>
                <label class={labelClass} for="check-date-email">{form.fields.email.label}</label>
                <input
                  class:list={[inputClass, 'mt-2']}
                  id="check-date-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={form.fields.email.placeholder}
                  required
                />
              </div>
            </div>

            <fieldset>
              <legend class={labelClass}>{form.fields.contactMethod.label}</legend>
              <div class="mt-3 grid gap-3">
                {
                  form.fields.contactMethod.options.map((option) => (
                    <label class="form-choice">
                      <input type="radio" name="contactMethod" value={option.value} required />
                      <span>{option.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div>
              <label class={labelClass} for="check-date-wedding-date"
                >{form.fields.weddingDate.label}</label
              >
              <input
                class:list={[inputClass, 'mt-2']}
                id="check-date-wedding-date"
                name="weddingDate"
                type="date"
                required
              />
            </div>
          </div>
        </div>

        {/* Step 2 — Event details */}
        <div class="hidden" data-form-panel="1" hidden>
          <p class="text-center text-sm text-muted sm:text-base">{form.steps[1].description}</p>

          <div class="mt-8 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="check-date-access-time"
                  >{form.fields.accessTime.label}</label
                >
                <input
                  class:list={[inputClass, 'mt-2']}
                  id="check-date-access-time"
                  name="accessTime"
                  type="text"
                  placeholder={form.fields.accessTime.placeholder}
                />
              </div>
              <div>
                <label class={labelClass} for="check-date-completion-time"
                  >{form.fields.completionTime.label}</label
                >
                <input
                  class:list={[inputClass, 'mt-2']}
                  id="check-date-completion-time"
                  name="completionTime"
                  type="text"
                  placeholder={form.fields.completionTime.placeholder}
                />
              </div>
            </div>

            <div>
              <label class={labelClass} for="check-date-location">{form.fields.location.label}</label>
              <input
                class:list={[inputClass, 'mt-2']}
                id="check-date-location"
                name="location"
                type="text"
                placeholder={form.fields.location.placeholder}
                required
              />
            </div>

            <fieldset>
              <legend class={labelClass}>{form.fields.bridalService.label}</legend>
              <div class="mt-3 grid gap-3">
                {
                  form.fields.bridalService.options.map((option) => (
                    <label class="form-choice">
                      <input type="radio" name="bridalService" value={option.value} required />
                      <span>{option.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset>
              <legend class={labelClass}>{form.fields.bridalTrial.label}</legend>
              <div class="mt-3 grid gap-3 sm:grid-cols-3">
                {
                  form.fields.bridalTrial.options.map((option) => (
                    <label class="form-choice">
                      <input type="radio" name="bridalTrial" value={option.value} required />
                      <span>{option.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>
        </div>

        {/* Step 3 — Services */}
        <div class="hidden" data-form-panel="2" hidden>
          <p class="text-center text-sm text-muted sm:text-base">{form.steps[2].description}</p>

          <div class="mt-8 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="check-date-general-hair"
                  >{form.fields.generalHair.label}</label
                >
                <input
                  class:list={[inputClass, 'mt-2']}
                  id="check-date-general-hair"
                  name="generalHair"
                  type="number"
                  min="0"
                  max="40"
                  inputmode="numeric"
                  placeholder={form.fields.generalHair.placeholder}
                />
                <p class={hintClass}>{form.fields.generalHair.hint}</p>
              </div>
              <div>
                <label class={labelClass} for="check-date-general-makeup"
                  >{form.fields.generalMakeup.label}</label
                >
                <input
                  class:list={[inputClass, 'mt-2']}
                  id="check-date-general-makeup"
                  name="generalMakeup"
                  type="number"
                  min="0"
                  max="40"
                  inputmode="numeric"
                  placeholder={form.fields.generalMakeup.placeholder}
                />
                <p class={hintClass}>{form.fields.generalMakeup.hint}</p>
              </div>
            </div>

            <div>
              <label class={labelClass} for="check-date-spray-tans"
                >{form.fields.sprayTans.label}</label
              >
              <select
                class:list={[inputClass, 'mt-2']}
                id="check-date-spray-tans"
                name="sprayTans"
              >
                <option value="" disabled selected>{form.fields.sprayTans.placeholder}</option>
                {
                  form.fields.sprayTans.options.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
            </div>

            <fieldset>
              <legend class={labelClass}>{form.fields.otherServices.label}</legend>
              <div class="mt-3 grid gap-3">
                {
                  form.fields.otherServices.options.map((option) => (
                    <label class="form-choice">
                      <input type="checkbox" name="otherServices" value={option.value} />
                      <span>{option.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div>
              <label class={labelClass} for="check-date-booking-stage"
                >{form.fields.bookingStage.label}</label
              >
              <select
                class:list={[inputClass, 'mt-2']}
                id="check-date-booking-stage"
                name="bookingStage"
                required
              >
                <option value="" disabled selected>{form.fields.bookingStage.placeholder}</option>
                {
                  form.fields.bookingStage.options.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class={labelClass} for="check-date-referral-source"
                >{form.fields.referralSource.label}</label
              >
              <select
                class:list={[inputClass, 'mt-2']}
                id="check-date-referral-source"
                name="referralSource"
              >
                <option value="" disabled selected>{form.fields.referralSource.placeholder}</option>
                {
                  form.fields.referralSource.options.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class={labelClass} for="check-date-referred-by"
                >{form.fields.referredBy.label}</label
              >
              <input
                class:list={[inputClass, 'mt-2']}
                id="check-date-referred-by"
                name="referredBy"
                type="text"
                placeholder={form.fields.referredBy.placeholder}
              />
            </div>

            <div>
              <label class={labelClass} for="check-date-notes">{form.fields.notes.label}</label>
              <textarea
                class:list={[inputClass, 'mt-2 min-h-28 resize-y']}
                id="check-date-notes"
                name="notes"
                placeholder={form.fields.notes.placeholder}
              ></textarea>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
          <button
            type="button"
            class="btn btn-outline px-6 py-3 text-xs uppercase disabled:pointer-events-none disabled:opacity-40"
            data-form-back
            hidden
          >
            {form.actions.back}
          </button>

          <button
            type="button"
            class="btn btn-dark ml-auto px-8 py-3 text-xs uppercase"
            data-form-next
          >
            {form.actions.next}
          </button>

          <button
            type="submit"
            class="btn btn-dark ml-auto hidden px-8 py-3 text-xs uppercase"
            data-form-submit
            hidden
          >
            {form.actions.submit}
          </button>
        </div>
      </form>

      <div class="hidden text-center" data-form-success hidden>
        <div
          class="mx-auto flex size-14 items-center justify-center rounded-full bg-[var(--color-accent-muted)]"
        >
          <span class="font-heading text-lg text-accent" aria-hidden="true">✓</span>
        </div>
        <h3 class="mt-6 text-2xl">{form.success.title}</h3>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted">
          {form.success.description}
        </p>
        <button
          type="button"
          class="btn btn-outline mt-8 px-6 py-3 text-xs uppercase"
          data-form-reset
        >
          {form.success.retry}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .form-choice {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface-elevated);
    padding: 0.875rem 1rem;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .form-choice:hover {
    border-color: color-mix(in oklab, var(--color-brand-500) 45%, var(--color-border));
  }

  .form-choice:has(input:checked) {
    border-color: var(--color-brand-900);
    background: color-mix(in oklab, var(--color-accent-muted) 55%, white);
  }

  .form-choice input {
    accent-color: var(--color-brand-900);
  }

  .form-choice span {
    font-size: 0.95rem;
    color: var(--color-brand-900);
  }

  [data-progress-item] {
    cursor: pointer;
  }

  [data-progress-item].is-active [data-progress-dot] {
    border-color: var(--color-brand-900);
    background: var(--color-brand-900);
    color: white;
  }

  [data-progress-item].is-active [data-progress-label],
  [data-progress-item].is-complete [data-progress-label] {
    color: var(--color-brand-900);
  }

  [data-progress-item].is-complete [data-progress-dot] {
    border-color: var(--color-accent);
    background: var(--color-accent-muted);
    color: var(--color-brand-900);
  }
</style>

<script>
  function initCheckDateForm(root: HTMLElement) {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const form = root.querySelector('form');
    const panels = Array.from(root.querySelectorAll('[data-form-panel]'));
    const progressItems = Array.from(root.querySelectorAll('[data-progress-item]'));
    const backButton = root.querySelector<HTMLButtonElement>('[data-form-back]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-form-next]');
    const submitButton = root.querySelector<HTMLButtonElement>('[data-form-submit]');
    const successPanel = root.querySelector<HTMLElement>('[data-form-success]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-form-reset]');
    const email = root.dataset.email ?? '';

    if (
      !form ||
      panels.length === 0 ||
      !backButton ||
      !nextButton ||
      !submitButton ||
      !successPanel ||
      !resetButton
    ) {
      return;
    }

    let step = 0;

    const updateProgress = () => {
      progressItems.forEach((item, index) => {
        const isActive = index === step;
        item.classList.toggle('is-active', isActive);
        item.classList.toggle('is-complete', index < step);
        if (isActive) {
          item.setAttribute('aria-current', 'step');
        } else {
          item.removeAttribute('aria-current');
        }
      });
    };

    const showStep = (index: number) => {
      step = index;

      panels.forEach((panel, panelIndex) => {
        const isActive = panelIndex === step;
        panel.classList.toggle('hidden', !isActive);
        panel.toggleAttribute('hidden', !isActive);
      });

      backButton.hidden = step === 0;
      nextButton.hidden = step === panels.length - 1;
      submitButton.hidden = step !== panels.length - 1;
      updateProgress();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    progressItems.forEach((item) => {
      item.addEventListener('click', () => {
        const target = Number(item.getAttribute('data-progress-item'));
        if (Number.isInteger(target) && target >= 0 && target < panels.length) {
          showStep(target);
        }
      });
    });

    const getFieldValue = (name: string) => {
      const field = form.elements.namedItem(name);
      if (field instanceof RadioNodeList) {
        return field.value;
      }
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        return field.value.trim();
      }
      return '';
    };

    const getCheckedValues = (name: string) =>
      Array.from(
        form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`),
      ).map((input) => input.value);

    const validateStep = (index: number) => {
      const panel = panels[index];
      if (!(panel instanceof HTMLElement)) return false;

      const fields = Array.from(
        panel.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          'input, textarea, select',
        ),
      );

      for (const field of fields) {
        if (!field.checkValidity()) {
          field.reportValidity();
          field.focus();
          return false;
        }
      }

      return true;
    };

    const formatLabel = (value: string) =>
      value
        .split('-')
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(' ');

    const line = (label: string, value: string) => (value ? `${label}: ${value}` : '');

    const buildMailto = () => {
      const weddingDate = getFieldValue('weddingDate');
      const otherServices = getCheckedValues('otherServices').map(formatLabel).join(', ');
      const subject = encodeURIComponent(`Date check request — ${weddingDate}`);
      const body = encodeURIComponent(
        [
          'Hi Effortless Beauty,',
          '',
          'I would like to check availability for my wedding.',
          '',
          line('Role', formatLabel(getFieldValue('role'))),
          line('Name', getFieldValue('name')),
          line('Email', getFieldValue('email')),
          line('Phone', getFieldValue('phone')),
          line('Preferred contact', formatLabel(getFieldValue('contactMethod'))),
          '',
          line('Event date', weddingDate),
          line('Access time', getFieldValue('accessTime')),
          line('Done by', getFieldValue('completionTime')),
          line('Location', getFieldValue('location')),
          '',
          line('Bridal service', formatLabel(getFieldValue('bridalService'))),
          line('Bridal trial', formatLabel(getFieldValue('bridalTrial'))),
          line('General hair services', getFieldValue('generalHair') || '0'),
          line('General makeup services', getFieldValue('generalMakeup') || '0'),
          line('Spray tans', getFieldValue('sprayTans')),
          line('Other services', otherServices),
          '',
          line('Booking stage', formatLabel(getFieldValue('bookingStage'))),
          line('Heard about us', formatLabel(getFieldValue('referralSource'))),
          line('Referred by', getFieldValue('referredBy')),
          getFieldValue('notes') ? `\nNotes:\n${getFieldValue('notes')}` : '',
        ]
          .filter(Boolean)
          .join('\n'),
      );

      return `mailto:${email}?subject=${subject}&body=${body}`;
    };

    backButton.addEventListener('click', () => {
      if (step > 0) showStep(step - 1);
    });

    nextButton.addEventListener('click', () => {
      if (!validateStep(step)) return;
      if (step < panels.length - 1) showStep(step + 1);
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!validateStep(step)) return;

      window.location.href = buildMailto();
      form.hidden = true;
      root.querySelector('[data-form-progress]')?.classList.add('hidden');
      successPanel.hidden = false;
      successPanel.classList.remove('hidden');
    });

    resetButton.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      successPanel.hidden = true;
      successPanel.classList.add('hidden');
      root.querySelector('[data-form-progress]')?.classList.remove('hidden');
      showStep(0);
    });

    showStep(0);
  }

  document.querySelectorAll('[data-check-date-form]').forEach((root) => {
    if (root instanceof HTMLElement) initCheckDateForm(root);
  });

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-check-date-form]').forEach((root) => {
      if (root instanceof HTMLElement) initCheckDateForm(root);
    });
  });
</script>
