---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import EditorialBand from '@/components/shared/EditorialBand.astro';
import ContentBlock from '@/components/shared/ContentBlock.astro';
import InfoList from '@/components/shared/InfoList.astro';
import SimpleCta from '@/components/shared/SimpleCta.astro';
import Button from '@/components/ui/Button.astro';
import { media } from '@/config/media';
import { studioContent, studioSeo } from '@/config/pages/studio';
---

<SiteLayout title={studioSeo.title} description={studioSeo.description} canonicalPath="/in-studio">
  <PageHero {...studioContent.hero} />

  <EditorialBand image={media.pages.studio} />

  <ContentBlock
    eyebrow="At the studio"
    title={studioContent.overview.title}
    description={studioContent.overview.description}
  >
    <InfoList items={studioContent.overview.items} columns={3} />
  </ContentBlock>

  <ContentBlock
    eyebrow="Find us"
    title={studioContent.note.title}
    description={studioContent.note.description}
    width="narrow"
    class="bg-surface-muted"
  >
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/contact" variant="dark" class="uppercase">
        Check your date
      </Button>
      <Button href="/contact" variant="outline" class="uppercase">
        Get directions
      </Button>
    </div>
  </ContentBlock>

  <SimpleCta title="Book a studio appointment" />
</SiteLayout>
