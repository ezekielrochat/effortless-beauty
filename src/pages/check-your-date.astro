---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import ContentBlock from '@/components/shared/ContentBlock.astro';
import InfoList from '@/components/shared/InfoList.astro';
import SimpleCta from '@/components/shared/SimpleCta.astro';
import Button from '@/components/ui/Button.astro';
import { checkYourDateContent, checkYourDateSeo } from '@/config/pages/check-your-date';
---

<SiteLayout
  title={checkYourDateSeo.title}
  description={checkYourDateSeo.description}
  canonicalPath="/check-your-date"
>
  <PageHero {...checkYourDateContent.hero} />

  <ContentBlock eyebrow="Next steps" title={checkYourDateContent.steps.title}>
    <InfoList items={checkYourDateContent.steps.items} columns={3} />
  </ContentBlock>

  <ContentBlock
    eyebrow="Your message"
    title={checkYourDateContent.include.title}
    width="narrow"
    class="bg-surface-muted"
  >
    <ul class="mx-auto max-w-md space-y-4 text-left">
      {
        checkYourDateContent.include.items.map((item) => (
          <li class="flex gap-3 text-base leading-relaxed text-muted">
            <span
              class="mt-2.5 size-1.5 shrink-0 rounded-full bg-[var(--color-accent)]"
              aria-hidden="true"
            />
            {item}
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button href={checkYourDateContent.contact.emailHref} variant="dark" class="uppercase">
        Email your date
      </Button>
      <Button href={checkYourDateContent.contact.phoneHref} variant="outline" class="uppercase">
        Call us
      </Button>
    </div>
  </ContentBlock>

  <SimpleCta
    title={checkYourDateContent.contact.title}
    primaryLabel="Email us"
    primaryHref={checkYourDateContent.contact.emailHref}
    secondaryLabel="Contact page"
    secondaryHref="/contact"
  />
</SiteLayout>
