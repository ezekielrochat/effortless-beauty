---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import { confirmationPages } from '@/config/pages/confirmation';

export function getStaticPaths() {
  return Object.entries(confirmationPages).map(([slug, page]) => ({
    params: { slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { slug } = Astro.params;
---

<SiteLayout
  title={page.seoTitle}
  description={page.seoDescription}
  canonicalPath={`/confirmation/${slug}`}
  noindex
>
  <PageHero
    eyebrow={page.eyebrow}
    title={page.title}
    titleAccent={page.titleAccent}
    description={page.description}
    primaryCta={page.primaryCta}
  />
</SiteLayout>
