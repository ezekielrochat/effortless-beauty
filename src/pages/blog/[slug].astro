---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SimpleCta from '@/components/shared/SimpleCta.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
>
  <article class="border-b border-default bg-[var(--color-surface-elevated)]">
    <div class="container-site max-w-3xl py-16 sm:py-20 lg:py-24">
      <p class="font-heading text-[0.68rem] tracking-[0.16em] text-subtle uppercase">
        {formatDate(post.data.pubDate)} · {post.data.author}
      </p>
      <h1 class="mt-5 text-4xl leading-tight tracking-[-0.02em] sm:text-5xl">{post.data.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-muted">{post.data.description}</p>
    </div>
  </article>

  <div class="container-site prose-article max-w-3xl py-14 sm:py-16">
    <Content />
  </div>

  <SimpleCta title="Planning your wedding?" />
</SiteLayout>

<style is:global>
  .prose-article h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .prose-article p,
  .prose-article li {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted, #5c6568);
  }

  .prose-article strong {
    color: var(--color-brand-900);
    font-weight: 600;
  }

  .prose-article ul {
    margin-top: 0.9rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
