---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import SimpleCta from '@/components/shared/SimpleCta.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<SiteLayout
  title="Blog"
  description="Bridal hair and makeup tips, trends, and the story of Effortless Beauty in Knoxville, TN."
  canonicalPath="/blog"
>
  <PageHero
    eyebrow="The Effortless Blog"
    title="Notes for Knoxville"
    titleAccent="brides."
    description="Trends, trial-day advice, and a little of our story — written to make booking hair and makeup feel simpler."
    primaryCta={{ label: 'Check your date', href: '/check-your-date' }}
  />

  <section class="py-16 sm:py-20">
    <div class="container-site mx-auto max-w-3xl space-y-10">
      {
        posts.map((post) => (
          <article class="border-b border-default pb-10 last:border-b-0">
            <p class="font-heading text-[0.68rem] tracking-[0.16em] text-subtle uppercase">
              {formatDate(post.data.pubDate)} · {post.data.author}
            </p>
            <h2 class="mt-3 text-2xl sm:text-3xl">
              <a href={`/blog/${post.id}`} class="transition-opacity hover:opacity-70">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted">{post.data.description}</p>
            <a
              href={`/blog/${post.id}`}
              class="mt-4 inline-block text-sm tracking-wide text-[var(--color-brand-900)] uppercase underline decoration-[var(--color-brand-300)] underline-offset-4"
            >
              Read article
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <SimpleCta title="Planning your wedding?" />
</SiteLayout>
