---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import SimpleCta from '@/components/shared/SimpleCta.astro';
import SiteImage from '@/components/ui/SiteImage.astro';
import { media } from '@/config/media';
import { galleryContent, gallerySeo } from '@/config/pages/gallery';
---

<SiteLayout title={gallerySeo.title} description={gallerySeo.description} canonicalPath="/gallery">
  <PageHero {...galleryContent.hero} />

  <section class="py-6 sm:py-8 lg:py-10">
    <div class="frame-bleed">
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-2.5 lg:grid-cols-4">
        {
          media.gallery.grid.map((image) => (
            <figure class="frame-media">
              <SiteImage src={image.src} alt={image.alt} class="aspect-[3/4] w-full object-cover" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <SimpleCta
    title="Love what you see?"
    secondaryLabel="See the experience"
    secondaryHref="/experience"
  />
</SiteLayout>
