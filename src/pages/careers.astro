---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import ContentBlock from '@/components/shared/ContentBlock.astro';
import InfoList from '@/components/shared/InfoList.astro';
import EditorialBand from '@/components/shared/EditorialBand.astro';
import SimpleCta from '@/components/shared/SimpleCta.astro';
import ApplicationForm from '@/components/careers/ApplicationForm.astro';
import { media } from '@/config/media';
import { careersContent, careersSeo } from '@/config/pages/careers';
---

<SiteLayout title={careersSeo.title} description={careersSeo.description} canonicalPath="/careers">
  <PageHero {...careersContent.hero} />
  <EditorialBand image={media.pages.careers} />

  <ContentBlock eyebrow="Culture" title={careersContent.culture.title}>
    <InfoList items={careersContent.culture.items} columns={3} />
  </ContentBlock>

  <ContentBlock
    eyebrow="Open roles"
    title={careersContent.openRoles.title}
    description={careersContent.openRoles.description}
    class="bg-surface-muted"
  >
    <InfoList items={careersContent.openRoles.items} columns={2} />
  </ContentBlock>

  <section id="apply" class="scroll-mt-24 py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <div class="mx-auto max-w-3xl text-center">
        <p class="font-heading text-[0.68rem] font-semibold tracking-[0.24em] text-[var(--color-brand-500)] uppercase">
          Join us
        </p>
        <h2 class="mt-4 text-3xl leading-tight tracking-[-0.01em] sm:text-4xl lg:text-[2.75rem]">
          {careersContent.apply.title}
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          {careersContent.apply.description}
        </p>
        <ApplicationForm />
      </div>
    </div>
  </section>

  <SimpleCta
    title="Want to join the team?"
    primaryLabel="Apply now"
    primaryHref={careersContent.apply.ctaHref}
    secondaryLabel="About us"
    secondaryHref="/about"
  />
</SiteLayout>
